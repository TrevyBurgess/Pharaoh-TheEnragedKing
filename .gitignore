*.dylib
*.so
*.a
*.lo
*.slo
*.mod
*.lai
*.la
*.out

# Logs and temporary files
*.log
*.user
*.userprefs
*.local
*.DS_Store
Thumbs.db

# Unreal Engine folders
Binaries/
Build/
Intermediate/
DerivedDataCache/
Saved/
Plugins/*/Binaries/
Plugins/*/Intermediate/
Engine/Saved/
Engine/Intermediate/

# ADDED: 3rd party Content
!/TheEnragedKing/Content
/TheEnragedKing/Content/*
!/TheEnragedKing/Content/_Content
!/TheEnragedKing/Content/CyberFF_BasicAssets

# ADDED: Deployment folder
Deploy
*.bin

# Autosaves, backups, crashes
Saved/Autosaves/
Saved/Backup/
Saved/CrashReports/

# Project files that can be regenerated
*.xcodeproj
*.xcworkspace

# Ignore uproject.log and crash reports
*.uproject.log

# Ignore Mac build folder
MacNoEditor/

# Ignore Windows build folder
WindowsNoEditor/

# Ignore Linux build folder
LinuxNoEditor/

# Ignore HTML5 build folder
HTML5NoEditor/

# Ignore iOS build folder
IOSNoEditor/

# Ignore Android build folder
AndroidNoEditor/

# Ignore any .tmp files
*.tmp

# Ignore old/backup files
*.bak

# Ignore config backups from Unreal
ConfigBackup/

# Ignore any other temp folders you may use
Temp/

# Ignore Editor config files
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Ignore custom Unreal cache
DerivedDataCache/

# Optional: Ignore user-specific config
*.ini.local

# Optional: Exclude project-specific content (customize as needed)
# /YourProject/Content/ExtraLargeOrGeneratedContent/